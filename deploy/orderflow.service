[Unit]
Description=Bybit Order Flow
After=network-online.target
[Service]
WorkingDirectory=/opt/orderflow
EnvironmentFile=/opt/orderflow/.env
ExecStart=/opt/orderflow/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8050 --workers 1
Restart=always
RestartSec=3
User=orderflow
[Install]
WantedBy=multi-user.target
